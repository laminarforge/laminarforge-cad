      (place C4 50000 -17000 front 0.0 (PN 100nF))
      (place C5 55000 -17000 front 0.0 (PN 100nF))
      (place C7 85000 -46000 front 0.0 (PN 100nF))
    )
    (component laminarforge:C_0805
