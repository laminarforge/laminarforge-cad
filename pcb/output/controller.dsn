(pcb controller.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "LaminarForge")
    (host_version "1.0")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary (path pcb 0  0 0  100000 0  100000 -80000  0 -80000  0 0))
    (plane GND (polygon F.Cu 0  0 0  100000 0  100000 -80000  0 -80000  0 0))
    (plane GND (polygon B.Cu 0  0 0  100000 0  100000 -80000  0 -80000  0 0))
    (keepout "" (circle signal 6950 4000 -4000))
    (keepout "" (circle signal 6950 96000 -4000))
    (keepout "" (circle signal 6950 4000 -76000))
    (keepout "" (circle signal 6950 96000 -76000))
    (via "Via[0-1]_600:300_um")
    (keepout "" (rect signal 0 0 100000 -1000))
    (keepout "" (rect signal 0 -79000 100000 -80000))
    (keepout "" (rect signal 0 0 1000 -80000))
    (keepout "" (rect signal 99000 0 100000 -80000))
    (rule (width 250) (clearance 230))
  )
  (placement
    (component MountingHole:MountingHole_3.2mm_M3
      (place H1 4000 -4000 front 0.0)
      (place H2 96000 -4000 front 0.0)
      (place H3 4000 -76000 front 0.0)
      (place H4 96000 -76000 front 0.0)
    )
    (component laminarforge:BarrelJack_2.1x5.5mm
      (place J1 8000 -8000 front 0.0 (PN DC_BARREL_2.1x5.5mm))
    )
    (component laminarforge:CP_Radial_D6.3mm
      (place C2 22000 -22000 front 0.0 (PN 220uF_10V))
    )
    (component laminarforge:CP_Radial_D8.0mm
      (place C1 18000 -10000 front 0.0 (PN 220uF_35V))
    )
    (component laminarforge:C_0603
