    )
    (class kicad_default GND +24V_IN +24V_SW +12V +5V +3V3 VBUS HEATER_SSR_MCU HEATER_SSR_OUT FAN_PWM FAN_GATE FAN_OUT_N CO2_SOL_PWM CO2_SOL_OUT_N WINDOW_HEATER SDA SCL DS18B20_DATA OVERTEMP_SW MHZ19_TX MHZ19_RX STEP DIR EN_N TMC_UART_TX TMC_UART_RX USB_DP USB_DN USB_CC1 USB_CC2 ESP_EN ESP_BOOT LED_PWR LED_WIFI LED_HEAT LED_FAULT LED_WIFI_DRV LED_HEAT_DRV LED_FAULT_DRV SWCLK SWDIO HEATER_SSR_PRE
      (circuit (use_via "Via[0-1]_600:300_um"))
      (rule (width 250) (clearance 230))
    )
  )
  (wiring)
)
