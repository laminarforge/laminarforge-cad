    )
    (net +24V_SW
      (pins U2-1 U2-5 D1-1 D2-1 C1-1 J11-4)
    )
    (net +12V
      (pins U2-2 L1-1 D3-1 D4-1 K1-3 J4-1 J5-1 J9-1)
    )
